# ---- Audiora 2.0 ----
# Copy to .env and edit. `docker compose` reads this file automatically.

# The domain you will point at this server. Caddy requests a Let's Encrypt
# cert for this name, so DNS must already resolve here and ports 80/443
# must be reachable from the internet.
AUDIORA_DOMAIN=music.example.com

# Optional: set to the email address Let's Encrypt expiry notices go to.
AUDIORA_ACME_EMAIL=you@example.com

# ---- Storage ----
# Where your music lives on the host. Read-only inside the container.
MUSIC_PATH=/srv/music

# Where Audiora keeps its database, cover art and transcode cache.
DATA_PATH=/srv/audiora-data

# ---- Server ----
# Bind address inside the container. Only Caddy should talk to this.
LISTEN_ADDR=:8080

# Comma-separated list of origins allowed to call the API. The web app and
# the mobile app both need to be here in production.
CORS_ORIGINS=https://music.example.com

# ---- Security ----
# REQUIRED. At least 32 random characters. Generate one with:
#   openssl rand -base64 48
AUDIORA_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Minutes an access token stays valid. Refresh tokens live 30 days.
ACCESS_TOKEN_TTL_MIN=15

# ---- Accounts ----
# Created on first boot only, when the database is empty. After that this
# is ignored; manage users from the admin UI or the CLI.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin

# ---- Scanning ----
# How often the background scanner walks MUSIC_PATH looking for new files.
# Set to 0 to disable and only scan manually from the admin UI.
SCAN_INTERVAL_MIN=30

# Import embedded cover art during scans.
EXTRACT_COVER_ART=true

# Compute a dominant colour per album to drive the UI's colour theming.
EXTRACT_COLORS=true

# Transcode the entire library to AAC 96k after a scan finishes, so first
# playback is never a live transcode. Uses CPU and disk; disable on a
# small Raspberry Pi.
PREWARM_TRANSCODE=false
